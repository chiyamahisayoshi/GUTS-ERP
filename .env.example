NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://erp.example.jp
# Optional. Defaults to .runtime/erp-errors.log under the ERP working directory.
# ERP_ERROR_LOG_PATH=/var/log/guts-erp/erp-errors.log

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=guts_erp
DB_PASSWORD=
DB_NAME=guts_erp
DB_POOL_SIZE=10

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=guts-erp
JWT_AUDIENCE=guts-parking
JWT_TTL_SECONDS=3600
PARKING_BACKEND_URL=http://127.0.0.1:8001
# Configure both values together. Use HTTPS remotely or HTTP on loopback only
# (recommended: http://127.0.0.1:8001/api/v1); PARKING_API_KEY must equal Parking's ERP_API_KEY.
PARKING_API_URL=
PARKING_API_KEY=

# Used only by npm run seed:admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
